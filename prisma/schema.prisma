// Prisma schema for Prompt-O-Phobia (PostgreSQL).
// Mirrors the former Mongoose models: a User authors many Prompts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for app runtime — safe for serverless.
  url       = env("DATABASE_URL")
  // Direct connection for migrations (migrate deploy / migrate dev).
  directUrl = env("DIRECT_URL")
}

model User {
  id       String   @id @default(cuid())
  clerkId  String?  @unique
  email    String   @unique
  username String
  image    String?
  prompts  Prompt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prompt {
  id     String @id @default(cuid())
  title  String
  prompt String
  tag    String

  // The author. Deleting a user removes their prompts.
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}
